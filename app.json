{
  "expo": {
    "name": "Amul Flash",
    "slug": "amul-flash",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "amulflash",
    "userInterfaceStyle": "automatic",
    "updates": {
      "url": "https://u.expo.dev/38eba317-b0d6-4ecf-99fa-3a0ed032fd0a"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.amul.flash"
    },
    "android": {
      "package": "com.amul.flash",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "USE_FULL_SCREEN_INTENT",
        "SYSTEM_ALERT_WINDOW",
        "WAKE_LOCK",
        "VIBRATE",
        "DISABLE_KEYGUARD",
        "RECEIVE_BOOT_COMPLETED",
        "POST_NOTIFICATIONS",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "AmulStockWidget",
              "label": "Amul Stock Tracker",
              "minWidth": "100dp",
              "minHeight": "50dp",
              "description": "Live Amul Protein Stock Status",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "sounds": [
            "./src/music/mixkit_alarm_digital_clock_beep_989.wav",
            "./src/music/mixkit_alert_alarm_1005.wav",
            "./src/music/mixkit_battleship_alarm_1001.wav",
            "./src/music/mixkit_classic_winner_alarm_1997.wav",
            "./src/music/mixkit_digital_clock_digital_alarm_buzzer_992.wav",
            "./src/music/mixkit_interface_hint_notification_911.wav",
            "./src/music/mixkit_sound_alert_in_hall_1006.wav",
            "./src/music/mixkit_spaceship_alarm_998.wav"
          ]
        }
      ],
      "expo-audio",
      "./plugins/withManifestFix.js"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "38eba317-b0d6-4ecf-99fa-3a0ed032fd0a"
      }
    }
  }
}
